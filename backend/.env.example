APP_NAME="MobieX API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

AUTH_TOKEN_EXPIRATION_DAYS=30
ORDER_RESERVATION_EXPIRATION_MINUTES=30

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mobiex_unified
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Media Storage Configuration
MEDIA_STORAGE_DRIVER=local
MEDIA_FALLBACK_TO_LOCAL=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
CLOUDINARY_FOLDER=mobiex
CLOUDINARY_SECURE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
# Supported drivers: "log" (writes to storage/logs/laravel.log), "smtp", "sendmail", "resend", "ses"
# Production / Staging: set MAIL_MAILER=smtp with valid credentials (e.g. Gmail App Password, Mailtrap, Brevo, SendGrid)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@mobiex.vn"
MAIL_FROM_NAME="MobieX - Công Nghệ & Phụ Kiện"

FRONTEND_URL=http://localhost:5173

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# VNPay credentials & environment configuration.
# - Local Development (Browser Return only): VNP_RETURN_URL=http://localhost:5173/payment/vnpay/return
# - Sandbox with Public HTTPS Tunnel (IPN enabled):
#     1. Run start_tunnel.bat -> copy https://<tunnel-host>
#     2. Configure VNP_IPN_URL=https://<tunnel-host>/api/payments/vnpay/ipn in your VNPay Merchant Portal
#     3. Set APP_URL=https://<tunnel-host> if backend links should use public HTTPS
# - Production: Set live VNPay URLs (https://pay.vnpay.vn/...) and your production domain URLs.
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_TRANSACTION_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNP_RETURN_URL=http://localhost:5173/payment/vnpay/return
VNP_IPN_URL=http://localhost:8000/api/payments/vnpay/ipn
# Set to true in local development when VNPay IPN tunnel is unavailable. Only active in non-production & sandbox URLs.
VNP_ALLOW_VERIFIED_RETURN_FALLBACK=false

# ZaloPay credentials. Obtain these from your ZaloPay merchant account.
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_QUERY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/query
ZALOPAY_REFUND_ENDPOINT=https://sb-openapi.zalopay.vn/v2/refund
ZALOPAY_REFUND_QUERY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/query_refund
ZALOPAY_RETURN_URL=http://localhost:5173/payment/zalopay/return
ZALOPAY_CALLBACK_URL=http://localhost:8000/api/payments/zalopay/callback

# MoMo credentials. Obtain these from your MoMo merchant account.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_QUERY_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/query
MOMO_REFUND_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/refund
MOMO_REFUND_QUERY_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/refund/query
MOMO_RETURN_URL=http://localhost:5173/payment/momo/return
MOMO_CALLBACK_URL=http://localhost:8000/api/payments/momo/callback

# Local development admin account.
# Keep empty in the committed example.
# Set credentials only in your untracked local .env.
RBAC_ADMIN_NAME=
RBAC_ADMIN_EMAIL=
RBAC_ADMIN_PASSWORD=

# Payment Accounts Configuration (Bank VietQR & MoMo QR)
PAYMENT_BANK_ID=vietcombank
PAYMENT_BANK_NAME="Ngân hàng TMCP Ngoại thương Việt Nam (Vietcombank)"
PAYMENT_BANK_ACCOUNT_NUMBER=1023034776
PAYMENT_BANK_ACCOUNT_NAME="DINH NGOC HAI"
PAYMENT_VIETQR_TEMPLATE=compact2

PAYMENT_MOMO_PHONE=0987880968
PAYMENT_MOMO_NAME=
PAYMENT_MOMO_NOTE_PREFIX="MobieX "

